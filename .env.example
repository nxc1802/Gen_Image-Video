# ==============================================================================
# FACTORY v4 — ENVIRONMENT CONFIGURATION TEMPLATE
# WARNING: NEVER COMMIT SENSITIVE TOKENS OR PASSWORDS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE FACTORY AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Production API Bearer token required for all non-public endpoints.
# Empty strings ("") are strictly prohibited and will cause the server to fail fast.
FACTORY_API_KEY=your_production_bearer_token_here
ENVIRONMENT=development

# JWT Configuration (for standardized JWT tokens alongside Bearer auth)
JWT_SECRET_KEY=your_jwt_signing_secret_min_32_chars_here
JWT_ALGORITHM=HS256
# Mandatory in production environment (ENVIRONMENT=production)
JWT_AUDIENCE=factory-api
JWT_ISSUER=factory-control-plane

# ------------------------------------------------------------------------------
# 2. CONTROL PLANE API SERVER & NETWORKING
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
IDLE_SHUTDOWN_MINUTES=120

# Reverse Proxy & Trusted Proxies (Prevents IP spoofing in X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1

# CORS & Asset Ingestion Security
FACTORY_CORS_ORIGINS=http://localhost:3000
FACTORY_MEDIA_ALLOWED_DOMAINS=s3-factory.ngrok.app
FACTORY_ASSET_ALLOWED_HOSTS=s3-factory.ngrok.app
ASSET_MAX_UPLOAD_MB=50
ASSET_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,audio/wav,audio/mpeg

# Request Timeout Middleware
REQUEST_TIMEOUT_SECONDS=60.0
REQUEST_TIMEOUT_ENABLED=true

# ------------------------------------------------------------------------------
# 3. RATE LIMITING MIDDLEWARE
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_PRUNE_INTERVAL=300

# ------------------------------------------------------------------------------
# 4. DATABASE & MIGRATIONS (ALEMBIC)
# ------------------------------------------------------------------------------
# Database backend: 'memory' (default lite mode), 'sqlite', or 'postgres'
FACTORY_DB_BACKEND=memory
FACTORY_AUTO_MIGRATE=false

# Connection strings for persistent databases (when FACTORY_DB_BACKEND is sqlite or postgres)
# DATABASE_URL=sqlite:///./factory.db
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/factory
SQLITE_DB_PATH=./factory.db

# In-Memory Queue & Repository Bounds
QUEUE_BACKEND=memory
FACTORY_MAX_JOBS=10000
JOB_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 5. STORAGE & ARTIFACT DELIVERY
# ------------------------------------------------------------------------------
# Storage backend: 'ephemeral_disk' (default lite mode) or 's3'
STORAGE_BACKEND=ephemeral_disk

# Scratch disk configuration
SCRATCH_ARTIFACTS_DIR=/tmp/factory_lite/artifacts
ARTIFACT_TTL_SECONDS=3600
ARTIFACT_SWEEP_INTERVAL_SECONDS=60
MAX_ARTIFACT_STORAGE_MB=5120
ARTIFACT_CLEANUP_ON_DOWNLOAD=false
LOCAL_STORAGE_SECRET_KEY=local-storage-token-secret-signing-key

# S3-compatible Object Storage (Active when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_PUBLIC_ENDPOINT_URL=https://s3-factory.ngrok.app
# S3_BUCKET_NAME=factory-artifacts
# S3_ACCESS_KEY=your_minio_access_key_here
# S3_SECRET_KEY=your_minio_secret_key_here
# S3_REGION=us-east-1
# S3_DOWNLOAD_URL_EXPIRATION_SECONDS=86400
# S3_UPLOAD_URL_EXPIRATION_SECONDS=3600

# ------------------------------------------------------------------------------
# 6. STUDIO WEB OPERATIONS CONSOLE (NEXT.JS 15)
# ------------------------------------------------------------------------------
# Base API URL used by the browser to connect to the Control Plane
NEXT_PUBLIC_CONTROL_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 7. KAGGLE DEPLOYMENT & SECRETS
# ------------------------------------------------------------------------------
# Used for Kaggle notebook execution and weights synchronization
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_bearer_token  # Standardized Kaggle Bearer Token (KGAT_...)
KAGGLE_KEY=your_kaggle_api_key           # Legacy hex key fallback
# KAGGLE_CONFIG_DIR=~/.kaggle
KAGGLE_INPUT_DIR=/kaggle/input
EXTRA_ARTIFACT_DIR=
HF_TOKEN=your_huggingface_user_token

# ------------------------------------------------------------------------------
# 8. EDGE NETWORKING & NGROK STATIC DOMAINS
# ------------------------------------------------------------------------------
# Static reserved domains per subsystem to guarantee persistent endpoint URLs
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN_CONTROL=jobs-factory.ngrok.app
NGROK_DOMAIN_STUDIO=studio-factory.ngrok.app
NGROK_DOMAIN_TEXT=text-factory.ngrok.app
NGROK_DOMAIN_VISION=vision-factory.ngrok.app
NGROK_DOMAIN_DECISION=decision-factory.ngrok.app
NGROK_DOMAIN_EMBEDDING=embed-factory.ngrok.app
NGROK_DOMAIN_RERANK=rerank-factory.ngrok.app
NGROK_DOMAIN_IMAGE=image-factory.ngrok.app
NGROK_DOMAIN_VIDEO=video-factory.ngrok.app
NGROK_DOMAIN_SPEECH=speech-factory.ngrok.app
NGROK_DOMAIN_MUSIC=music-factory.ngrok.app
NGROK_DOMAIN_ENHANCEMENT=enhance-factory.ngrok.app

# ------------------------------------------------------------------------------
# 9. DISTRIBUTED TRACING & OBSERVABILITY (OPENTELEMETRY)
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=factory-control-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------------------------
# 10. NATIVE BACKEND URLS (NO FAKE FALLBACKS)
# ------------------------------------------------------------------------------
VLLM_TEXT_URL=http://127.0.0.1:8080
VLLM_VLM_URL=http://127.0.0.1:8081
VLLM_DECISION_URL=http://127.0.0.1:8082
VLLM_EMBEDDING_URL=http://127.0.0.1:8083
VLLM_RERANK_URL=http://127.0.0.1:8084
QWEN_ASR_URL=http://127.0.0.1:8290
QWEN_TTS_URL=http://127.0.0.1:8291
QWEN_ALIGNER_URL=
ACESTEP_API_URL=http://127.0.0.1:8008
ACESTEP_API_KEY=your_production_bearer_token_here

# Enhancement backends
IMAGE_SR_BACKEND_URL=
VIDEO_SR_BACKEND_URL=
RIFE_BACKEND_URL=
AUDIO_ENHANCE_BACKEND_URL=

# ==============================================================================
# FACTORY v4 — ENVIRONMENT CONFIGURATION TEMPLATE
# WARNING: NEVER COMMIT SENSITIVE TOKENS OR PASSWORDS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE FACTORY AUTHENTICATION & SECURITY (MANDATORY)
# ------------------------------------------------------------------------------
# Production API Bearer token required for all non-public endpoints.
# Empty strings ("") are strictly prohibited and will cause the server to fail fast.
FACTORY_API_KEY=your_production_bearer_token_here
JWT_SECRET_KEY=your_jwt_signing_secret_min_32_chars_here
JWT_ALGORITHM=HS256
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. CONTROL PLANE API SERVER
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false
IDLE_SHUTDOWN_MINUTES=120

# ------------------------------------------------------------------------------
# 3. EDGE NETWORKING & NGROK STATIC DOMAINS
# ------------------------------------------------------------------------------
# Static reserved domains per subsystem to guarantee persistent endpoint URLs
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN_CONTROL=jobs-factory.ngrok.app
NGROK_DOMAIN_STUDIO=studio-factory.ngrok.app
NGROK_DOMAIN_TEXT=text-factory.ngrok.app
NGROK_DOMAIN_VISION=vision-factory.ngrok.app
NGROK_DOMAIN_DECISION=decision-factory.ngrok.app
NGROK_DOMAIN_EMBEDDING=embed-factory.ngrok.app
NGROK_DOMAIN_RERANK=rerank-factory.ngrok.app
NGROK_DOMAIN_IMAGE=image-factory.ngrok.app
NGROK_DOMAIN_VIDEO=video-factory.ngrok.app
NGROK_DOMAIN_SPEECH=speech-factory.ngrok.app
NGROK_DOMAIN_MUSIC=music-factory.ngrok.app
NGROK_DOMAIN_ENHANCEMENT=enhance-factory.ngrok.app

# Comma-separated allowlist required by the native vLLM VLM server.
# Use only trusted media hosts such as your S3/MinIO public hostname.
FACTORY_MEDIA_ALLOWED_DOMAINS=s3-factory.ngrok.app
FACTORY_ASSET_ALLOWED_HOSTS=s3-factory.ngrok.app
FACTORY_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. FACTORY LITE QUEUE & STORAGE (ZERO EXTERNAL INFRASTRUCTURE)
# ------------------------------------------------------------------------------
# In-memory GPU-partitioned queue with lease-based lifecycle management.
# External PostgreSQL and Redis are NOT required for Factory v4 Lite.
QUEUE_BACKEND=memory

# Storage Backend: ephemeral_disk (default for Factory Lite) or optional s3
STORAGE_BACKEND=ephemeral_disk
FACTORY_STORAGE_DIR=/tmp/factory_lite/artifacts
STORAGE_TTL_SECONDS=3600

# Optional S3-compatible configuration (ONLY if STORAGE_BACKEND=s3 is explicitly configured)
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET_NAME=factory-artifacts
# S3_ACCESS_KEY=your_minio_access_key_here
# S3_SECRET_KEY=your_minio_secret_key_here
# S3_REGION=us-east-1

# SSRF Protection & Ingestion Validation
ASSET_MAX_UPLOAD_MB=50
ASSET_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,audio/wav,audio/mpeg

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED TRACING & OBSERVABILITY (OPENTELEMETRY)
# ------------------------------------------------------------------------------
OTEL_SERVICE_NAME=factory-control-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------------------------
# 7. OPTIONAL HOSTED DEPLOYMENT CREDENTIALS (KAGGLE / HUGGINGFACE)
# ------------------------------------------------------------------------------
# Used exclusively for downloading weights or building wheels datasets
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_bearer_token  # Standardized Kaggle Bearer Token (KGAT_...)
KAGGLE_KEY=your_kaggle_api_key           # Legacy fallback
HF_TOKEN=your_huggingface_user_token


# ------------------------------------------------------------------------------
# 8. NATIVE BACKEND URLS (NO FAKE FALLBACKS)
# ------------------------------------------------------------------------------
VLLM_TEXT_URL=http://127.0.0.1:8080
VLLM_VLM_URL=http://127.0.0.1:8081
VLLM_DECISION_URL=http://127.0.0.1:8082
VLLM_EMBEDDING_URL=http://127.0.0.1:8083
VLLM_RERANK_URL=http://127.0.0.1:8084
QWEN_ASR_URL=http://127.0.0.1:8290
QWEN_TTS_URL=http://127.0.0.1:8291
QWEN_ALIGNER_URL=
ACESTEP_API_URL=http://127.0.0.1:8008
# Usually set equal to FACTORY_API_KEY; keep both explicit for native ACE-Step auth.
ACESTEP_API_KEY=your_production_bearer_token_here

# Enhancement remains unavailable unless real model workers are supplied.
IMAGE_SR_BACKEND_URL=
VIDEO_SR_BACKEND_URL=
RIFE_BACKEND_URL=
AUDIO_ENHANCE_BACKEND_URL=
